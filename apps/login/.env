# Mshairi: servimos o login como app PRÓPRIO, na raiz do domínio de cada marca
# (login.seusocio.app, login.mshairi.app). O upstream usa /ui/v2/login porque lá ele vive
# DENTRO do container do Zitadel.
#
# Com o valor do upstream, o app sobe em /ui/v2/login enquanto o Zitadel redireciona para
# <baseUri>/login — a RAIZ. O domínio responde, a página existe, e todo login dá 404.
#
# Fica aqui, e não num .env.production nem numa variável da Vercel: o .env.production não
# venceu a precedência, e a Vercel REJEITA variável de valor vazio — que é o que isto
# precisa ser.
NEXT_PUBLIC_BASE_PATH=
EMAIL_VERIFICATION=false
ZITADEL_API_URL=http://localhost:8080
ZITADEL_SERVICE_USER_TOKEN_FILE=../../login-client.pat

# Whether ui_locales from OAuth requests should always override the language cookie.
# When set to "true", the language from ui_locales will always be used.
# When unset or set to "false", ui_locales only sets the language if no cookie exists (preserves user's manual selection).
# ZITADEL_UI_LOCALES_OVERRIDE_COOKIE=false
