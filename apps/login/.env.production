# Mshairi — overrides do build de PRODUÇÃO (Next carrega este arquivo por cima do .env).
#
# Nada de segredo aqui: segredos vivem nas variáveis do projeto na Vercel. Isto existe porque um
# valor VAZIO não pode ser expresso lá — a Vercel rejeita variável sem valor — e o default do
# upstream é justamente o que precisamos anular.

# O upstream serve o login sob /ui/v2/login, porque lá ele vive DENTRO do container do Zitadel.
# Nós o servimos como um app próprio, na raiz do domínio da marca (login.seusocio.app,
# login.mshairi.app). Sem este override o app subiria em /ui/v2/login e TODO login daria 404:
# o Zitadel redireciona para <baseUri>/login, que é a raiz. O domínio responderia, a página
# existiria, e o fluxo inteiro estaria quebrado — sem nada acusar.
NEXT_PUBLIC_BASE_PATH=
